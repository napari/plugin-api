// Cloudflare configuration for the npe2api Worker.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "npe2api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Built by `python scripts/build_site.py` from the data branch.
    "directory": "../site",
    "binding": "ASSETS",
    // Files are served without running the Worker. Only a request that
    // matches no file reaches src/index.js.
    "not_found_handling": "none"
  },
  // The hostnames are attached in the Cloudflare dashboard or here once the
  // DNS zones are confirmed (napari-plans: canonical hostname ticket).
  // "routes": [
  //   { "pattern": "api.napari.org", "custom_domain": true },
  //   { "pattern": "api.napari-hub.org", "custom_domain": true }
  // ],
  // npe2api.<account>.workers.dev, and pr-<number>-npe2api.<account>.workers.dev
  // for previews uploaded from pull requests.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
